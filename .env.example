# Copy to .env and adjust. Every value here is a local-demo default; none are real secrets.

# Postgres / PostGIS (host port 55432 avoids clashing with a local Postgres on 5432)
POSTGRES_HOST=localhost
POSTGRES_PORT=55432
POSTGRES_HOST_PORT=55432
POSTGRES_USER=pomorie
POSTGRES_PASSWORD=pomorie
POSTGRES_DB=pomorie

# Redpanda (Kafka API)
KAFKA_BOOTSTRAP=localhost:19092

# S3-compatible object storage (SeaweedFS locally; AWS S3 in a real deployment)
S3_ENDPOINT=http://localhost:8333
S3_ACCESS_KEY=pomorie-local
S3_SECRET_KEY=pomorie-local-secret
S3_BUCKET=pomorie-photos

# HMAC key for pseudonyms (licence plates, analytics reporter ids)
PSEUDONYM_KEY=local-demo-pseudonym-key

# Dagster UI (3000 is often taken by local dev servers)
DAGSTER_PORT=3030

# Read-only dashboard login (member of analytics_reader)
DASHBOARD_DB_USER=dashboard
DASHBOARD_DB_PASSWORD=dashboard-local

# Manual-review endpoints (a real deployment would use OIDC)
REVIEWER_TOKEN=local-demo-reviewer-token

# Optional: Slack-compatible webhook for Dagster run-failure alerts
ALERT_WEBHOOK_URL=

# Optional Redpanda console (docker compose --profile tools up -d redpanda-console)
REDPANDA_CONSOLE_PORT=8080
